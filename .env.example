# Sarvam AI credentials. Copy to `.env` and fill in.
# The key is read ONLY by server/proxy.mjs (a Node process). It is never
# exposed to the browser — do not rename this to VITE_SARVAM_API_KEY, because
# any VITE_* variable is compiled into the public JS bundle.
SARVAM_API_KEY=

# Optional model overrides
SARVAM_CHAT_MODEL=sarvam-m
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v2

# Local proxy port (must match the vite.config.ts proxy target)
SAHAYAK_PROXY_PORT=8787
